# Copy to `.env` and edit. Loaded automatically by `clip serve` / `clip dev`.
# Also loaded by Vite for the frontend dev server.
#
# Precedence: .env.local > .env > shell environment > nothing.
# Both files are gitignored.

# ---------- AI clip suggestions (choose one) ----------

# Option A — OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, llama.cpp, real OpenAI).
# Auto-selected when OPENAI_BASE_URL is set.
# OPENAI_BASE_URL=https://website.com
# MODEL_NAME=llm
# OPENAI_API_KEY=123456

# Option B — Anthropic Claude (fallback when no OPENAI_BASE_URL is set).
# ANTHROPIC_API_KEY=sk-ant-...
# CLIPPER_ANALYZE_MODEL=claude-sonnet-4-6  # optional override

# Force a provider when both are configured. Otherwise auto-detects.
# CLIPPER_LLM_PROVIDER=openai              # or "anthropic"

# ---------- Auth ----------

# Shared token gate for the FastAPI server. Unset = no auth (local dev).
# Generate with: openssl rand -hex 24
# CLIPPER_TOKEN=

# ---------- Storage ----------

# Where uploads, clips, thumbnails, and the SQLite db live.
# Defaults to <repo>/data/
# CLIPPER_DATA_ROOT=

# ---------- Models ----------

# Override the Whisper model. Default is English-only; switch to
# `large-v3` for multilingual.
# CLIPPER_WHISPER_MODEL=distil-large-v3

# ---------- System library paths ----------

# Where torchcodec finds ffmpeg shared libs. Defaults to conda's lib dir.
# VIDPROC_FFMPEG_LIB=/home/elstruck/miniconda3/lib
